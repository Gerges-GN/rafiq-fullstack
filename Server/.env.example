# Required API and database settings
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/rafiq
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# In Vercel, set FRONTEND_ORIGINS to the exact deployed HTTPS frontend origin(s).

# Optional: used by the recommendation endpoint
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_API_KEY=your-groq-api-key
MODEL=llama-3.1-8b-instant

# Optional: enables server-side profile image uploads and the demo image importer
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Optional and normally left unset; explicitly enables the legacy, admin-only
# review-copy tool. Its source and target are fixed by these values, never the request body.
REVIEW_MIGRATION_SOURCE_DB=
REVIEW_MIGRATION_TARGET_DB=

# Optional: database scanning is disabled unless this is explicitly true.
ENABLE_ADMIN_DB_SCAN=false
